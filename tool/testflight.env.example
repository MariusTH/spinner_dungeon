# Copy to tool/testflight.env (gitignored) for ./tool/deploy_testflight.sh:
#
#   cp tool/testflight.env.example tool/testflight.env
#
# Values come from App Store Connect -> Users and Access -> Integrations ->
# App Store Connect API. Use a Team Key with the App Manager role (an
# Individual key cannot create provisioning profiles).

APPSTORE_CONNECT_API_KEY_ID=
APPSTORE_CONNECT_ISSUER_ID=

# Point at the downloaded .p8 on disk...
# APPSTORE_CONNECT_API_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# ...or inline the full file contents instead. Quote it so the newlines survive:
#
# APPSTORE_CONNECT_API_KEY_CONTENT="-----BEGIN PRIVATE KEY-----
# MIGT...
# -----END PRIVATE KEY-----"
APPSTORE_CONNECT_API_KEY_CONTENT=

# Optional: overrides the auto-derived build number for one run.
# BUILD_NUMBER=
